---
import Base from '../layouts/Base.astro';
import { loadFacts } from '../data';
import { uniqueSources } from '../lib/sources';

const facts = await loadFacts();
// One entry per source. The numbers match the [n] citations on the fact cards.
const sources = uniqueSources(facts);
---
<Base title="Sources">
  <article class="prose">
    <h1>Sources</h1>
    <p>Every source behind a fact on this site. Citation style: MLA.</p>
    <ol>
      {sources.map((f) => (
        <li>{f.source_url ? <a href={f.source_url} target="_blank" rel="noopener noreferrer">{f.source_title}</a> : f.source_title}{f.year && `, ${f.year}`}</li>
      ))}
    </ol>
    <h2>Other sources</h2>
    <p class="todo">Owner: to be decided. Add background sources that are not behind a single fact.</p>
  </article>
</Base>
