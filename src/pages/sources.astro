---
import Base from '../layouts/Base.astro';
import { loadFacts } from '../data';

const facts = await loadFacts();
// One entry per source, sorted by title. Sources come from the fact file, so the list stays complete.
const sources = [...new Map(facts.map((f) => [`${f.source_title}|${f.source_url ?? ''}`, f])).values()]
  .sort((x, y) => x.source_title.localeCompare(y.source_title));
---
<Base title="Sources">
  <article class="prose">
    <h1>Sources</h1>
    <p>Every source behind a fact on this site. Citation style: MLA.</p>
    <ol>
      {sources.map((f) => (
        <li>{f.source_url ? <a href={f.source_url}>{f.source_title}</a> : f.source_title}{f.year && `, ${f.year}`}</li>
      ))}
    </ol>
    <h2>Other sources</h2>
    <p class="todo">Owner: to be decided. Add background sources that are not behind a single fact.</p>
  </article>
</Base>
