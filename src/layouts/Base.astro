---
// Shared layout: header, and a footer with the AI-use note.
// Markdown pages use it through `layout:` in their frontmatter.
import '../styles/global.css';

const { title, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title;

const NAV = [
  ['/', 'Explore'],
  ['/about', 'About'],
  ['/method', 'Method'],
  ['/sources', 'Sources'],
  ['/gaps', 'Gaps'],
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>{pageTitle ? `${pageTitle} · Same But Different` : 'Same But Different'}</title>
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a class="name" href="/">Same But Different</a>
        <nav aria-label="Main">
          {NAV.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
        </nav>
      </header>
      <main>
        {frontmatter ? <article class="prose"><slot /></article> : <slot />}
      </main>
      <footer class="site-footer">
        <span>AI use: the team used AI tools to help with research, the prototype and the code.</span>
        <span>Code: MIT · Facts and text: CC BY 4.0 · <a href="https://github.com/lizababior/same-but-different">GitHub</a></span>
      </footer>
    </div>
  </body>
</html>
