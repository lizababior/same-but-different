---
// Shared layout: header, and a footer with the AI-use note.
// Markdown pages use it through `layout:` in their frontmatter.
import '../styles/global.css';

const { title, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title;

const NAV = [
  ['/', 'Explore'],
  ['/about', 'About'],
  ['/method', 'Method'],
  ['/sources', 'Sources'],
  ['/gaps', 'Gaps'],
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>{pageTitle ? `${pageTitle} · Same But Different` : 'Same But Different'}</title>
    <script is:inline>
      // Apply the saved theme before the page paints, so it does not flash. No saved choice = follow the system.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a class="name" href="/">Same But Different</a>
        <nav aria-label="Main">
          {NAV.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
        </nav>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode">
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </header>
      <main>
        {frontmatter ? <article class="prose"><slot /></article> : <slot />}
      </main>
      <footer class="site-footer">
        <span>AI use: the team used AI tools to help with research, the prototype and the code.</span>
        <span>Code: MIT · Facts and text: CC BY 4.0 · <a href="https://github.com/lizababior/same-but-different">GitHub</a></span>
      </footer>
    </div>
    <script is:inline>
      // Light/dark toggle. The choice is saved in this browser only.
      (() => {
        const root = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const label = () => btn.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode');
        label();
        btn.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          label();
        });
      })();
    </script>
  </body>
</html>
